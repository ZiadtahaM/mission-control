# ============================================================
# LaunchKit — Environment Variables
# Copy this file to .env and fill in all required values.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Full PostgreSQL connection string (used in Replit / production)
DATABASE_URL=postgresql://launchkit:changeme@localhost:5432/launchkit

# Docker Compose splits these out (compose builds DATABASE_URL from them)
POSTGRES_USER=launchkit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=launchkit

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ──────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SESSION_SECRET=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars

# ── Stripe ──────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from your Stripe product catalogue)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:21434
